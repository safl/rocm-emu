# Pins for every package; the Makefile and the build scripts read this file.

# rocjitsu: the ROCm/rocm-systems revision the server is built from. The guest
# firmware's ip_discovery.bin comes from the same build, so both move together.
ROCM_SYSTEMS_REPO=https://github.com/ROCm/rocm-systems
ROCM_SYSTEMS_SHA=98f6a72dcc49a5f809593deacbe5c9df89cde3b3

# Host packages target the distribution the server runs on.
HOST_RELEASE=26.04

# Guest packages target the nosi ubuntu-2610-rocm image: its release, and the
# kernel it boots. The amdgpu package is built for exactly this kernel, from
# the matching linux-source, so it moves whenever the image's kernel does.
GUEST_RELEASE=26.10
GUEST_KVER=7.3.0-9-generic
GUEST_KSRC=linux-source-7.3.0
GUEST_KSRC_VERSION=7.3.0-9.9

# Our revision of the packaging, appended to each upstream version.
PKG_REV=1
